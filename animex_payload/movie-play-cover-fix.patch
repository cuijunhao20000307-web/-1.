+
+struct MediaProbeBuffer {
+    std::string data;
+    size_t limit = 128 * 1024;
+    bool truncated = false;
+};
+
+static size_t media_probe_write_cb(void* ptr, size_t size, size_t nmemb, void* userdata) {
+    if (!ptr || !userdata) return 0;
+    auto* out = static_cast<MediaProbeBuffer*>(userdata);
+    const size_t n = size * nmemb;
+    const size_t room = out->data.size() < out->limit ? out->limit - out->data.size() : 0;
+    const size_t take = std::min(room, n);
+    if (take) out->data.append(static_cast<const char*>(ptr), take);
+    if (take < n || out->data.size() >= out->limit) {
+        out->truncated = true;
+        return 0; // enough bytes to identify the response; stop a large MP4 body
+    }
+    return n;
+}
+
+static bool media_probe_payload(const std::string& body, const std::string& content_type) {
+    size_t p = 0;
+    if (body.size() >= 3 && (unsigned char)body[0] == 0xef &&
+        (unsigned char)body[1] == 0xbb && (unsigned char)body[2] == 0xbf) p = 3;
+    while (p < body.size() && std::isspace((unsigned char)body[p])) ++p;
+    if (body.compare(p, 7, "#EXTM3U") == 0) return true;
+
+    // ISO-BMFF/MP4 normally exposes an ftyp box in the first few dozen bytes.
+    const size_t inspect = std::min<size_t>(body.size(), 96);
+    for (size_t i = 4; i + 4 <= inspect; ++i)
+        if (body.compare(i, 4, "ftyp") == 0) return true;
+
+    std::string ct = content_type;
+    std::transform(ct.begin(), ct.end(), ct.begin(),
+                   [](unsigned char c){ return (char)std::tolower(c); });
+    return ct.find("video/mp4") != std::string::npos ||
+           ct.find("application/vnd.apple.mpegurl") != std::string::npos ||
+           ct.find("application/x-mpegurl") != std::string::npos ||
+           ct.find("audio/mpegurl") != std::string::npos;
+}
+
+static bool media_probe_once(const ProxyConfig& proxy,
+                             const std::string& url,
+                             const std::string& referer,
+                             std::string& effective_url,
+                             std::string& body,
+                             std::string& reason) {
+    CURL* c = curl_easy_init();
+    if (!c) { reason = "线路探测初始化失败"; return false; }
+    MediaProbeBuffer capture;
+    NetworkOptions options;
+    options.connect_timeout_seconds = 4;
+    options.total_timeout_seconds = 7;
+    options.low_speed_seconds = 3;
+    options.max_attempts = 1;
+    options.network_mode = proxy.network_mode;
+    options.allow_ipv4_fallback = false;
+    network_apply_common(c, options);
+    network_apply_proxy(c, proxy);
+    curl_easy_setopt(c, CURLOPT_URL, url.c_str());
+    curl_easy_setopt(c, CURLOPT_RANGE, "0-131071");
+    curl_easy_setopt(c, CURLOPT_WRITEFUNCTION, media_probe_write_cb);
+    curl_easy_setopt(c, CURLOPT_WRITEDATA, &capture);
+    curl_easy_setopt(c, CURLOPT_REFERER, referer.empty() ? nullptr : referer.c_str());
+    curl_easy_setopt(c, CURLOPT_USERAGENT,
+                     "Mozilla/5.0 (Nintendo Switch; ANIMEX/0.8.1) AppleWebKit/537.36");
+    curl_easy_setopt(c, CURLOPT_ACCEPT_ENCODING, "");
+    curl_easy_setopt(c, CURLOPT_IPRESOLVE,
+                     proxy.mode == PROXY_MODE_DIRECT && proxy.network_mode != 0
+                         ? CURL_IPRESOLVE_V4 : CURL_IPRESOLVE_WHATEVER);
+
+    const CURLcode rc = curl_easy_perform(c);
+    long http = 0;
+    curl_easy_getinfo(c, CURLINFO_RESPONSE_CODE, &http);
+    char* effective = nullptr;
+    if (curl_easy_getinfo(c, CURLINFO_EFFECTIVE_URL, &effective) == CURLE_OK && effective)
+        effective_url = effective;
+    else effective_url = url;
+    char* ct = nullptr;
+    std::string content_type;
+    if (curl_easy_getinfo(c, CURLINFO_CONTENT_TYPE, &ct) == CURLE_OK && ct)
+        content_type = ct;
+    curl_easy_cleanup(c);
+
+    body = std::move(capture.data);
+    const bool transport_ok = rc == CURLE_OK || (capture.truncated && rc == CURLE_WRITE_ERROR);
+    if (!transport_ok || http < 200 || http >= 400) {
+        reason = "线路 HTTP/网络响应无效";
+        return false;
+    }
+    if (media_probe_payload(body, content_type)) return true;
+    reason = "线路返回的不是视频数据";
+    return false;
+}
+
+static bool media_probe_movie_url(const ProxyConfig& proxy,
+                                  std::string& url,
+                                  std::string& referer,
+                                  std::string& reason) {
+    // First mimic the site's no-referrer playback policy. Some mirrors instead
+    // require the site referer, so retry that policy only when the first probe
+    // returns non-media data.
+    for (int policy = 0; policy < 2; ++policy) {
+        const std::string probe_referer = policy == 0 ? referer : "https://kanju1.com/";
+        std::string effective, body;
+        if (media_probe_once(proxy, url, probe_referer, effective, body, reason)) {
+            if (is_direct_media(effective)) url = effective;
+            referer = probe_referer;
+            return true;
+        }
+
+        // Some line URLs are public resolver pages despite carrying a media
+        // extension. Pull a literal MP4/HLS URL out of their HTML/JSON body.
+        std::string nested = attr_direct_media(body);
+        if (nested.empty()) nested = literal_media_url(body);
+        if (!nested.empty() && nested != url) {
+            std::string nested_effective, nested_body, nested_reason;
+            if (media_probe_once(proxy, nested, probe_referer,
+                                 nested_effective, nested_body, nested_reason)) {
+                url = is_direct_media(nested_effective) ? nested_effective : nested;
+                referer = probe_referer;
+                reason = "已从线路响应提取真实视频地址";
+                return true;
+            }
+        }
+    }
+    return false;
+}

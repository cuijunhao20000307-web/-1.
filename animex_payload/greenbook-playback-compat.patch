+static std::string json_http_url(const std::string& text) {
+    // Resolver APIs commonly return {"url":"https://..."} without a media
+    // filename suffix. Extract the URL and let the byte probe decide whether
+    // it is really HLS/MP4 instead of rejecting it by extension alone.
+    const char* keys[] = {"\"url\"", "\"play_url\"", "\"playUrl\"", "\"media_url\""};
+    for (const char* key : keys) {
+        size_t search = 0;
+        while (true) {
+            size_t p = text.find(key, search);
+            if (p == std::string::npos) break;
+            p = text.find(':', p + std::strlen(key));
+            if (p == std::string::npos) break;
+            ++p;
+            while (p < text.size() && std::isspace((unsigned char)text[p])) ++p;
+            if (p < text.size() && text[p] == '"') ++p;
+            const size_t b = p;
+            bool esc = false;
+            for (; p < text.size(); ++p) {
+                const char c = text[p];
+                if (!esc && (c == '"' || c == '\n' || c == '\r')) break;
+                if (c == '\\' && !esc) esc = true;
+                else esc = false;
+            }
+            std::string u = clean_url(text.substr(b, p - b));
+            if (u.rfind("https://", 0) == 0 || u.rfind("http://", 0) == 0) return u;
+            search = p + 1;
+        }
+    }
+    return {};
+}
